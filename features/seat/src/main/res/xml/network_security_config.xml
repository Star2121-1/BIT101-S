<?xml version="1.0" encoding="utf-8"?>
<!--
  seatlib.bit.edu.cn 的 TLS 链不完整，需要客户端补一张中间证书。

  问题（2026-09-18 实测）：
    seatlib.bit.edu.cn 的服务器**只下发叶证书**，不下发中间证书，
    openssl 报 `Verify return code: 21 (unable to verify the first certificate)`。
    同一张证书、同一个签发者，学校其他服务器（login.bit.edu.cn、www.bit.edu.cn）
    都正确下发了完整链（3 张）并验证通过 —— 这是 seatlib 单独的配置缺陷。

  为什么必须由客户端兜底：
    Windows / curl 会自动去 AIA 取中间证书补链，**Android 不会**。
    因此所有干净的 Android 客户端都会在 TLS 握手验证阶段失败，
    表现为 OkHttp 抛 `Trust anchor for certification path not found`。
    这也正是本项目历史上「模拟器连不上 seatlib」的真实原因
    （当年误判为学校防火墙封锁 TCP 443）。

  为什么只能改在客户端：
    `ssl_certificate` 漏配中间证书属于服务端问题，正确修法是在 seatlib 的
    nginx 配置里把中间证书拼进证书文件。建议向学校反馈；
    在那之前只能用这里的方式兜底。

  安全性：
    这里新增的信任锚是 Thawte TLS RSA CA G1（DigiCert 的公共中间 CA），
    且**只对 seatlib.bit.edu.cn 生效**，不影响其他域名的校验证策。
    该证书已用密码学方式验证过确实是签发 seatlib 叶证书的那一张：
      openssl verify -untrusted intermediate.pem -CAfile root.pem leaf.pem  ->  OK
      openssl verify -CAfile root.pem intermediate.pem                      ->  OK
    把中间证书作为信任锚，与正常情况下经由根证书传递的信任等价，未额外放宽。
-->
<network-security-config>

    <!-- 默认策略：只用系统信任锚，不放宽任何域名 -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!--
      校园网自助（深澜 Srun）：`http://10.0.0.55` 是纯 HTTP 内网服务，
      没有证书可言 —— 只对这个内网 IP 放行明文（2026-09-24）。
      不影响其他域名的 HTTPS 校验策略。
    -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.0.55</domain>
    </domain-config>

    <!-- 仅对 seatlib 追加缺失的中间证书 -->
    <domain-config>
        <domain includeSubdomains="true">seatlib.bit.edu.cn</domain>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/thawte_tls_rsa_ca_g1" />
        </trust-anchors>
    </domain-config>

</network-security-config>
