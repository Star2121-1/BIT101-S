<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      桌面小组件。用传统的 AppWidgetProvider（不是 Glance 的 GlanceAppWidgetReceiver）——
      点击后直接 `AppWidgetManager.updateAppWidget()` 同步重绘，不经过任何异步 Session。
      详见 WidgetViews 的类注释。
    -->
    <application>

        <receiver
            android:name="cn.bit101.android.features.widget.BIT101WidgetProvider"
            android:exported="false"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/bit101_widget_info" />
        </receiver>

    </application>

</manifest>
