<?xml version="1.0" encoding="utf-8"?>
<!--
  组件用到的样式。

  ⚠️ RemoteViews 只认 LinearLayout / FrameLayout / RelativeLayout / GridLayout
  这几个容器，样式必须落在这类控件上，不能用 ConstraintLayout 或自定义 View。
-->
<resources>

    <!-- 页签：横向均分剩余宽度（refresh 固定 48dp）。
         底色与文字色都写在 **XML 资源属性**里（@drawable / @color 引用）：
         RemoteViews 每次重放动作表都按宿主当前配置重新解析 XML 属性，
         系统切深浅色时页签颜色即时跟变（A6 修复）。
         选中/未选中的差异不靠“换色”（一块视图的资源属性是静态的），
         而靠成对视图切可见性 —— 见 widget_root.xml 的 tab_N / tab_sel_N。 -->
    <style name="WidgetTab">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/widget_tab_normal</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/widget_tab_text</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!-- 选中页签：同几何，仅底色（圆角药丸）与文字色换成选中款。
         ⚠️ A6 修复为什么不用 setTextAppearance(资源 id)：实测在真实宿主上不可行 ——
         TextView.setTextAppearance(int) 没有 @RemotableViewMethod 注解，
         RemoteViews.getMethod 在宿主重放时直接抛 ActionException「can't use method
         with RemoteViews」，组件整块显示 "Can't load widget"（证据：
         evidence/2026-10-19-a1/b1-actionexception-logcat.txt + b1-cant-load-widget.png）。
         颜色走 XML 属性则是资源引用、宿主重放时按当前配置解析 —— 效果同样即时，
         且完全不引入反射动作。 -->
    <style name="WidgetTabSelected" parent="WidgetTab">
        <item name="android:background">@drawable/widget_tab_selected</item>
        <item name="android:textColor">@color/widget_tab_selected_text</item>
    </style>

    <!-- ===== 列表条目（widget_item.xml） ===== -->

    <!-- 课程名 / 空闲：独占全宽。允许换行到 2 行 ——
         窄组件下「计算机系统导论」这类名字不再被截成一个字（真机 2026-09-21 实测）。
         仍保留 ellipsize 兜底超长名。 -->
    <style name="WidgetItemMain">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:maxLines">2</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!-- 第 2 行：时间 + 地点，整体靠右。
         ⚠️ 时间与地点都为空时整行由代码隐藏（否则留一条空行占高度）。 -->
    <style name="WidgetItemMeta">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">end</item>
    </style>

    <!-- 上课时间：`09:55-12:20`，比教室稍显眼一点（用正文色而非次要色） -->
    <style name="WidgetItemTime">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:maxLines">1</item>
        <item name="android:textSize">12sp</item>
    </style>

    <!-- 教室 / 剩余时间 -->
    <style name="WidgetItemTrail">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textSize">12sp</item>
    </style>

    <!-- ===== 底部说明与动作键（widget_root.xml） ===== -->

    <!-- 底部说明行：课程页的「今天 · 9月21日 周一 · 第3周」。
         marginTop 6→2dp（T1-c-DEF-1：末条被视口底边裁字，回收与底边距合计 7dp
         让视口容纳整数行；见 report-t1c-b10-widget-dark.md §2.4） -->
    <style name="WidgetFooter">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textColor">@color/widget_text_secondary</item>
        <item name="android:textSize">12sp</item>
    </style>

    <!-- 座位页的「立即预约 / 登录」按钮：胶囊底 + 强调色文字 -->
    <style name="WidgetAction">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">34dp</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:background">@drawable/widget_action_background</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">1</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:textColor">@color/widget_tab_selected_text</item>
        <item name="android:textSize">14sp</item>
    </style>

</resources>
