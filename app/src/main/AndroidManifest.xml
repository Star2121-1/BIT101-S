<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 只需要联网；网络状态类权限代码里从未使用（WorkManager 等库自带声明） -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.BIT101"
        android:usesCleartextTraffic="true"
        tools:targetApi="31">
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".features.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.BIT101">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- NFC 贴纸快捷入口：贴纸里写着 bit101://nfc/shortcut?to=<某页>，
                 碰一下就唤起 App 并跳过去。 -->
            <!-- ⚠️ scheme/host/pathPrefix 三样都收紧：不写死的话，任何写着网址的贴纸
                 都能唤起我们，然后因为解不出白名单内的 route 而「唤起了却没反应」，
                 那种 bug 最难查。收紧之后别人的贴纸根本唤不起本 App。 -->
            <intent-filter>
                <action android:name="android.nfc.action.NDEF_DISCOVERED" />

                <category android:name="android.intent.category.DEFAULT" />

                <data
                    android:scheme="bit101"
                    android:host="nfc"
                    android:pathPrefix="/shortcut" />
            </intent-filter>
        </activity>
    </application>

</manifest>